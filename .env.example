NODE_ENV=production
PORT=3000
POSTGRES_PASSWORD=replace-with-a-long-unique-password
BETTER_AUTH_URL=https://app.flyshowcase.com
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=postgres://flyapp:replace-with-a-long-password@db:5432/flyapp
DB_POOL_SIZE=10
UPLOAD_DIR=/data/uploads

# Configure a private authenticated SMTP relay for verification and password reset.
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=flyapp@example.com
SMTP_PASSWORD=replace-with-mail-password
SMTP_FROM=FLYApp <no-reply@flyshowcase.com>
