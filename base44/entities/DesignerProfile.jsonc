{
  "name": "DesignerProfile",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "brand_name": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "logo_url": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "instagram": {
      "type": "string"
    },
    "event_id": {
      "type": "string"
    }
  },
  "required": [
    "user_email"
  ],
  "rls": {
