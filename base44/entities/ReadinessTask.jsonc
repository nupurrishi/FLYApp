{
  "name": "ReadinessTask",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "acknowledgement",
        "prep",
        "fitting",
        "wardrobe"
      ],
      "default": "prep"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "done": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "event_id",
    "user_email",
    "title"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}