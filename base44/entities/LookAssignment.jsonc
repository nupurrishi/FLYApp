{
  "name": "LookAssignment",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string"
    },
    "look_id": {
      "type": "string"
    },
    "model_email": {
      "type": "string"
    },
    "model_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "assigned",
        "confirmed",
        "fitted"
      ],
      "default": "assigned"
    },
    "fitting_notes": {
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "look_id",
    "model_email"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}